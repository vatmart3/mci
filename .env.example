# ─────────────────────────────────────────────────────────────
# MCI Sète — variables d'environnement
# Sans aucune de ces clés, le site démarre en MODE DÉMO complet
# (catalogue seed, commandes/comptes en localStorage, emails journalisés).
# ─────────────────────────────────────────────────────────────

# URL publique du site (canonical, sitemap, Open Graph, liens des emails)
NEXT_PUBLIC_SITE_URL=https://www.mci-sete.com

# Supabase (Postgres + Auth + Storage). Les 2 clés publiques activent le mode production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service (serveur uniquement) : envoi d'emails fiables, scripts mirror:pdfs / seed
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails transactionnels). Sans clé : emails écrits dans la console serveur.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "MCI Sète <commandes@mci-sete.com>"
EMAIL_FROM=
# Destinataire(s) des notifications internes MCI, séparés par des virgules
MCI_NOTIFY_EMAILS=contactmci@sfr.fr

# Forcer le mode démo même si Supabase est configuré (présentation)
NEXT_PUBLIC_FORCE_DEMO=
